{
  "name": "calendar-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "ical.js": "^2.2.1",
    "jsdom": "^30.1.3",
    "lucide-vue-next": "^1.0.0",
    "mqtt": "^5.16.1",
    "nuxt": "^4.6.3",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@vue/test-utils": "^2.5.1",
    "aedes": "^1.2.0",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
