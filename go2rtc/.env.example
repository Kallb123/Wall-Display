# Copy to .env (which git ignores) and fill in.

# This machine's address on the LAN, as the wall and your phone reach it.
HOST_IP=192.168.1.10

# The login the cameras' RTSP streams take. A password with characters such as
# @ : / # must be URL-encoded (@ is %40), because it goes into an address.
REOLINK_USER=admin
REOLINK_PASSWORD=change-me

FRONT_DOOR_IP=192.168.1.50
